# Copy to mcp-server/.env and fill in. Never commit the real .env.
# Same project URL and anon key the web app uses (see the repo root .env).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Dedicated read-only account. Create it in Supabase Auth, add it to
# organization_members with role 'Viewer'. See README.md. Never use your own login.
WHITLEND_MCP_EMAIL=mcp-readonly@example.com
WHITLEND_MCP_PASSWORD=

# Only needed if the account belongs to more than one organization.
WHITLEND_ORG_ID=

# redacted (default) withholds borrower contact details unless a tool call asks for them.
# full returns them by default. Everything returned is sent to Anthropic's API.
WHITLEND_MCP_PII=redacted

# Hard cap on rows any single tool will return.
WHITLEND_MCP_MAX_ROWS=200
